# OrQuanta — Production Environment Template
# Copy to .env.prod and fill in real values before deploying
# NEVER commit .env.prod to git — it contains secrets

# ── Core ──────────────────────────────────────────────────────────────────────
ENV=production
ENVIRONMENT=production
PORT=8000
APP_URL=https://orquanta.com

# ── Security (GENERATE REAL VALUES — do not use defaults) ─────────────────────
# Generate: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=CHANGE_ME_generate_with_secrets_token_hex_32
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=720
AUDIT_HMAC_KEY=CHANGE_ME_generate_with_secrets_token_hex_32
SECRET_KEY=CHANGE_ME_generate_with_secrets_token_hex_32

# ── Database ───────────────────────────────────────────────────────────────────
# Render:  copied automatically via fromDatabase in render.yaml
# Coolify: postgresql+asyncpg://orquanta:<password>@postgres:5432/orquanta
# Neon:    postgresql+asyncpg://user:pass@ep-xxx.neon.tech/orquanta?sslmode=require
DATABASE_URL=postgresql+asyncpg://orquanta:CHANGE_ME@postgres:5432/orquanta
POSTGRES_PASSWORD=CHANGE_ME

# ── Redis ──────────────────────────────────────────────────────────────────────
# Upstash: rediss://default:<token>@<host>.upstash.io:6379
# Docker:  redis://redis:6379/0
REDIS_URL=redis://redis:6379/0

# ── ChromaDB ──────────────────────────────────────────────────────────────────
CHROMA_HOST=chromadb
CHROMA_PORT=8200

# ── CORS ───────────────────────────────────────────────────────────────────────
CORS_ORIGINS=https://orquanta.com,https://www.orquanta.com

# ── Admin ──────────────────────────────────────────────────────────────────────
ADMIN_EMAIL=admin@orquanta.ai
ADMIN_PASSWORD=CHANGE_ME_strong_password

# ── LLM Providers ──────────────────────────────────────────────────────────────
LLM_PROVIDER=mock          # Change to 'openai' or 'anthropic' when keys are set
DEMO_MODE=false
ORQUANTA_DEMO_MODE=false
USE_REAL_PROVIDERS=false
OPENAI_API_KEY=            # Optional — sk-...
ANTHROPIC_API_KEY=         # Optional — sk-ant-...

# ── Safety ─────────────────────────────────────────────────────────────────────
SAFETY_MAX_DAILY_SPEND_USD=5000
SAFETY_MAX_CONCURRENT_AGENTS=10
SAFETY_RATE_LIMIT_PER_MINUTE=60
SAFETY_AUTO_APPROVE_USD=100.0

# ── Monitoring ─────────────────────────────────────────────────────────────────
SENTRY_DSN=                # Optional — https://xxx@sentry.io/yyy
SLACK_WEBHOOK_URL=         # Optional
SENDGRID_API_KEY=          # Optional

# ── Cloud Providers ────────────────────────────────────────────────────────────
RUNPOD_API_KEY=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
GCP_PROJECT_ID=
AZURE_SUBSCRIPTION_ID=
COREWEAVE_API_KEY=
